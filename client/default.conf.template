# Docker's embedded DNS server. Without an explicit resolver, nginx resolves
# upstream hostnames exactly once at startup and caches the result forever. The
# pull-based deploy recreates `api` without recreating `client`, so the api
# container gets a new IP while nginx keeps proxying to the old one -- which by
# then belongs to another container (or nothing), giving 502s on every proxied
# route. Re-resolving on a short TTL keeps us pointed at the live container.
resolver 127.0.0.11 valid=10s ipv6=off;

# In production the AWS load balancer terminates TLS and tells us the client's
# original scheme in X-Forwarded-Proto. Pass that through to Django (so
# SECURE_PROXY_SSL_HEADER sees https and generated links use https); fall back
# to our own $scheme when no proxy set it (local development).
map $http_x_forwarded_proto $client_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Redirect only requests the load balancer received over plain HTTP. Its
# health checks carry no forwarded headers today; they are also exempted by
# user agent so a change there can never turn them into 301s (which would mark
# the target unhealthy and take the site down). First matching regex wins.
map "$http_x_forwarded_proto|$http_user_agent" $redirect_to_https {
    default                    0;
    "~^http\|ELB-HealthChecker" 0;
    "~^http\|"                 1;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    root /usr/share/nginx/html;
    index index.html index.htm;

    client_max_body_size 500M;

    # Plain-HTTP requests that came through the load balancer go to HTTPS.
    # Keyed on the proxy header only, so local development (no load balancer,
    # no header) is unaffected.
    if ($redirect_to_https) {
        return 301 https://$host$request_uri;
    }

    # Using a variable in proxy_pass forces nginx to resolve the name per
    # request (via the resolver above) instead of pinning it at startup.
    set $api_upstream http://api:8000;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # The app shell. Browsers must revalidate it on every load: it names the
    # content-hashed JS/CSS bundles, so a cached copy keeps running the
    # previous release's code against the new API after a deploy. (The hashed
    # bundles themselves stay cached for 30 days below.) add_header here
    # replaces the server-level headers, so the security headers are repeated.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }

    location = /pdf.worker.min.js {
        alias /usr/share/nginx/html/pdf.worker.min.js;
        add_header Content-Type application/javascript;
        add_header Access-Control-Allow-Origin "*";  # Add this line
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location /builder/ {
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        client_max_body_size 500M;
    }

    location /ws/ {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        client_max_body_size 500M;
    }

    location /token/ {
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        client_max_body_size 500M;
    }

    location /admin/ {
        proxy_pass $api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        client_max_body_size 500M;
    }

    error_page 405 =200 $uri;

    # Static file caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location /media/ {
        alias /usr/share/nginx/html/media/;
        add_header Access-Control-Allow-Origin "*";
        add_header Access-Control-Allow-Methods "GET, OPTIONS";
    }

    location ^~ /static/ {
        alias /usr/share/nginx/html/staticfiles/;
        add_header X-debug-path $request_filename always;  # This will help us see the actual path
    }

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;

    # Security headers
    # HSTS for this host only (no includeSubDomains/preload: other
    # helioanalytics.io hosts are not all served over HTTPS). Browsers ignore
    # the header on plain-HTTP responses, which are redirected above anyway.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}

# New server block just for Flower
server {
    listen 80;
    server_name ${NGINX_FLOWER_SERVER_NAME};  # Flower dashboard vhost

    set $flower_upstream http://flower:5555;

    location / {
        proxy_pass $flower_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }

    # Static files
    location /static/ {
        alias /etc/nginx/flower_static/;
        expires 30d;
    }
}