## Scraper Variables
ADS_TOKEN=<YOUR_ADS_TOKEN>
DATA_DIR_NAME="non_soho"

## App Variables
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY> # required for LLM API calls (requires gpt-4 access)
EMAIL=<YOUR_EMAIL> # will be displayed on the frontend as a point of contact

REDIS_HOST=redis

CONFIG_DIR=../config

## S3 Storage (set USE_S3=true for production)
USE_S3=false
AWS_STORAGE_BUCKET_NAME=your-s3-bucket
AWS_S3_REGION_NAME=us-east-1

## Bedrock Batch (required for bedrock provider batch jobs)
AWS_BATCH_ROLE_ARN=arn:aws:iam::<BEDROCK_ACCOUNT_ID>:role/pdl-bedrock-batch-role
# Required on prod EC2: instance role assumes this to call Bedrock APIs cross-account.
# Leave unset locally if AWS_ACCESS_KEY_ID/etc are already in the Bedrock account.
AWS_BEDROCK_INVOKE_ROLE_ARN=arn:aws:iam::<BEDROCK_ACCOUNT_ID>:role/pdl-bedrock-invoke-role